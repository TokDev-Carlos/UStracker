    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>UStracker.Shell</AssemblyName>
    <RootNamespace>UStracker.Shell</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <Compile Include="..\Shared\RootPaths.cs" Link="Shared\RootPaths.cs" />
  </ItemGroup>
</Project>
